{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook busy goose 2>/dev/null || true", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook busy goose 2>/dev/null || true", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook busy goose 2>/dev/null || true", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook done goose 2>/dev/null || true", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook idle goose 2>/dev/null || true", "timeout": 5 }] }
    ]
  }
}
