{
  "pluglight": {
    "PreInvocation": [
      { "type": "command", "command": "/usr/local/bin/pluglight hook busy antigravity 2>/dev/null || true; echo '{}'", "timeout": 5 }
    ],
    "PostToolUse": [
      { "matcher": "ask_question|ask_permission", "hooks": [{ "type": "command", "command": "/usr/local/bin/pluglight hook busy antigravity 2>/dev/null || true; echo '{}'", "timeout": 5 }] }
    ],
    "Stop": [
      { "type": "command", "command": "/usr/local/bin/pluglight hook stop antigravity 2>/dev/null || true; echo '{\"decision\":\"stop\"}'", "timeout": 5 }
    ]
  }
}
